{
  "name": "boostpay-mobile",
  "private": true,
  "version": "1.0.0",
  "description": "BoostPay Android app shell (Capacitor) — same React bundle, native container",
  "type": "module",
  "scripts": {
    "prepare:user": "node scripts/prepare.mjs user",
    "prepare:agent": "node scripts/prepare.mjs agent",
    "prepare:management": "node scripts/prepare.mjs management",
    "prepare:admin": "node scripts/prepare.mjs admin",
    "sync": "cap sync android",
    "open": "cap open android",
    "apk:debug": "cd android && ./gradlew assembleDebug",
    "apk:release": "cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/app": "^6.0.2",
    "@capacitor/core": "^6.2.0",
    "@capacitor/haptics": "^6.0.2",
    "@capacitor/keyboard": "^6.0.3",
    "@capacitor/status-bar": "^6.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0"
  }
}
